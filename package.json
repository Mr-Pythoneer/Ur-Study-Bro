{
  "name": "clever-snail",
  "version": "5.2.6",
  "description": "A macOS study partner desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "build:win": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "build:linux": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --linux",
    "build:all": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --win --linux"
  },
  "build": {
    "appId": "com.cleversnail.app",
    "productName": "Ur Study Bro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "node_modules/imap/**/*",
      "node_modules/mailparser/**/*",
      "node_modules/readable-stream/**/*",
      "node_modules/iconv-lite/**/*",
      "node_modules/encoding/**/*",
      "node_modules/charset-detector/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "Mr-Pythoneer",
      "repo": "Ur-Study-Bro"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.education",
      "target": [
        { "target": "dmg", "arch": ["arm64"] },
        { "target": "dmg", "arch": ["x64"] },
        { "target": "dmg", "arch": ["universal"] }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "nsis", "arch": ["ia32"] },
        { "target": "nsis", "arch": ["arm64"] }
      ]
    },
    "linux": {
      "icon": "build/icon.icns",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "AppImage", "arch": ["arm64"] },
        { "target": "pacman",   "arch": ["x64"] },
        { "target": "pacman",   "arch": ["arm64"] }
      ]
    }
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "author": { "name": "Mr-Pythoneer", "email": "mr.pythoneer@github.com" },
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "imap": "^0.8.19",
    "mailparser": "^3.9.15"
  },
  "overrides": {
    "html-to-text": "^10.0.1",
    "js-yaml": "^4.3.1",
    "utf7": { "semver": "^5.7.2" }
  }
}
